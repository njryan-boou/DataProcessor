# Copy to .env at the repository root. backend/.env can override these values.
# Process environment variables take precedence. Restart the backend after changes.
DATAFLOW_MAX_UPLOAD_MB=20
DATAFLOW_MAX_ROWS=200000
DATAFLOW_MAX_COLUMNS=200
DATAFLOW_MAX_DATASETS=8
DATAFLOW_HISTORY_LIMIT=20
DATAFLOW_MAX_MEMORY_MB=512
DATAFLOW_DATASET_TTL_SECONDS=3600

# Optional. Leave the key empty to use the limited local request parser.
# Supply real keys through your local .env or secure environment settings.
# If cloud networking is restricted, allow the configured provider hostname.
DATAFLOW_AI_API_KEY=
DATAFLOW_AI_BASE_URL=https://api.openai.com/v1
DATAFLOW_AI_MODEL=gpt-4o-mini
